{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wspolne-plotno",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "DrawRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DrawRoom"] }]
}
